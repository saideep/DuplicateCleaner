<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>DuplicateCleaner Report — {{ report.generated_at.strftime('%Y-%m-%d %H:%M:%S') }} UTC</title>
<style>
  body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
         margin: 2em; color: #222; }
  header { border-bottom: 2px solid #444; padding-bottom: 1em; margin-bottom: 2em; }
  header h1 { margin: 0 0 0.3em; }
  .summary { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1em; margin: 1em 0; }
  .summary .card { background: #f7f7f9; padding: 1em; border-radius: 6px; }
  .summary .card .n { font-size: 1.8em; font-weight: 600; }
  .group { border: 1px solid #ddd; border-radius: 6px; margin-bottom: 1.5em; padding: 1em; }
  .group h3 { margin: 0 0 0.5em 0; font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
              font-size: 1em; color: #444; }
  .group .meta { color: #666; font-size: 0.9em; margin-bottom: 0.75em; }
  table { width: 100%; border-collapse: collapse; }
  th, td { padding: 0.4em 0.6em; text-align: left; border-bottom: 1px solid #eee;
           vertical-align: top; }
  th { background: #fafafa; font-weight: 600; font-size: 0.8em;
       text-transform: uppercase; color: #666; letter-spacing: 0.03em; }
  tr.keeper { background: #eaffea; }
  tr.info-only { background: #fff8e1; }
  td.discard { color: #a33; }
  td.discard .path-text { text-decoration: line-through; }
  .path { font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
          font-size: 0.85em; word-break: break-all; }
  .score { font-weight: 600; text-align: right;
           font-family: ui-monospace, SFMono-Regular, Menlo, monospace; }
  .signals { font-size: 0.8em; color: #555; }
  .signals ul { margin: 0; padding-left: 1.1em; }
  .signals li { margin: 0.1em 0; }
  .badge { display: inline-block; padding: 0.1em 0.55em; border-radius: 3px;
           font-size: 0.72em; font-weight: 700; letter-spacing: 0.04em; color: white; }
  .badge.keep    { background: #2e7d32; }
  .badge.discard { background: #c62828; }
  .badge.info    { background: #ef6c00; }
  .badge.recon   { background: #1565c0; margin-left: 0.3em; }
  .badge.tree    { background: #6a1b9a; margin-left: 0.3em; }
  .badge.imgdup    { background: #00838f; margin-left: 0.3em; }
  .badge.audio-dup { background: #ad1457; margin-left: 0.3em; }
  .badge.video-dup { background: #4527a0; margin-left: 0.3em; }
  .tree-group    { border-left: 5px solid #6a1b9a; }
  .tree-meta     { background: #f3e5f5; padding: 0.6em 0.9em; border-radius: 4px;
                   margin: 0.5em 0 0.9em 0; font-size: 0.9em; }
  .tree-diff     { margin-top: 0.5em; font-size: 0.85em; color: #444; }
  .tree-diff table { margin-top: 0.3em; }
  .tree-diff td, .tree-diff th { font-size: 0.8em; }
  .imgdup-group    { border-left: 5px solid #00838f; }
  .audio-dup-group { border-left: 5px solid #ad1457; }
  .video-dup-group { border-left: 5px solid #4527a0; }
  .audio-dup-meta  { background: #fce4ec; padding: 0.6em 0.9em; border-radius: 4px;
                     margin: 0.5em 0 0.9em 0; font-size: 0.9em; }
  .video-dup-meta  { background: #ede7f6; padding: 0.6em 0.9em; border-radius: 4px;
                     margin: 0.5em 0 0.9em 0; font-size: 0.9em; }
  .imgdup-meta   { background: #e0f7fa; padding: 0.6em 0.9em; border-radius: 4px;
                   margin: 0.5em 0 0.9em 0; font-size: 0.9em; }
  footer { margin-top: 3em; font-size: 0.85em; color: #888; }
  code { background: #f2f2f4; padding: 0.05em 0.35em; border-radius: 3px; }
</style>
</head>
<body>

<header>
  <h1>DuplicateCleaner Report</h1>
  <p>Generated {{ report.generated_at.strftime('%Y-%m-%d %H:%M:%S') }} UTC.
     Scanned {{ report.total_files_scanned }} files under
     {% for r in report.roots %}<code>{{ r }}</code>{% if not loop.last %}, {% endif %}{% endfor %}.</p>
  {% if report.discover %}
  <p style="background:#fff3cd;border:1px solid #d0a800;border-radius:4px;
            padding:0.6em 1em;">
    <strong>Discovery mode</strong> — no keepers proposed. This report is an
    inventory; <code>dc apply</code> will refuse to run against it.
  </p>
  {% endif %}
</header>

<section class="summary">
  <div class="card">
    <div class="n">{{ report.total_groups }}</div>
    <div>duplicate group{% if report.total_groups != 1 %}s{% endif %}</div>
  </div>
  <div class="card">
    <div class="n">{{ report.total_reclaim_bytes | human_bytes }}</div>
    <div>reclaimable if all discards moved to Trash</div>
  </div>
  <div class="card">
    <div class="n">{{ report.total_files_scanned }}</div>
    <div>files scanned</div>
  </div>
</section>

{% set tree_groups = report.groups | selectattr('kind', 'equalto', 'tree') | list %}
{% if tree_groups %}
<h2>Project trees ({{ tree_groups | length }})</h2>
<p>Two or more directories detected as copies of the same project. Trashing the
   discard side reclaims the whole tree at once — the mover sends the entire
   directory to the Trash atomically.</p>

{% for g in tree_groups %}
<div class="group tree-group">
  <h3><span class="badge tree">TREE</span> Group {{ g.id }}</h3>
  <div class="tree-meta">
    <strong>{{ (g.similarity_pct or 0) | round(1) }}%</strong> similarity ·
    <strong>{{ g.identical_file_count or 0 }}</strong> identical files ·
    reclaim <strong>{{ g.reclaim_bytes | human_bytes }}</strong>
  </div>
  <table>
    <thead>
      <tr>
        <th style="width:64px;"></th>
        <th>Project directory</th>
        <th style="width:90px;">Total</th>
        <th style="width:70px;">Score</th>
        <th>Signals</th>
      </tr>
    </thead>
    <tbody>
    {% for m in g.members %}
      <tr class="{% if m.is_proposed_keeper %}keeper{% endif %}">
        <td>
          {% if m.is_proposed_keeper %}
            <span class="badge keep">KEEP</span>
          {% else %}
            <span class="badge discard">TRASH TREE</span>
          {% endif %}
        </td>
        <td class="path"><span class="path-text">{{ m.path }}/</span></td>
        <td>{{ m.size | human_bytes }}</td>
        <td class="score">{{ m.score | signed }}</td>
        <td class="signals">
          <ul>
            {% for s in m.signals %}
              <li>{{ s.name }}{% if s.contribution != 0 %}: {{ s.contribution | signed }}{% endif %}</li>
            {% endfor %}
          </ul>
        </td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  {% if g.tree_diff %}
  <details class="tree-diff">
    <summary>{{ g.tree_diff | length }} differing file(s) shown</summary>
    <table>
      <thead>
        <tr>
          <th>Relative path</th>
          {% for m in g.members %}<th>{{ m.path.name }}</th>{% endfor %}
        </tr>
      </thead>
      <tbody>
      {% for d in g.tree_diff %}
        <tr>
          <td class="path">{{ d.relative_path }}</td>
          {% for h in d.hashes_per_member %}<td class="path">{% if h %}{{ h[:12] }}…{% else %}<em>missing</em>{% endif %}</td>{% endfor %}
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </details>
  {% endif %}
</div>
{% endfor %}
{% endif %}

{% set image_near_dup_groups = report.image_near_dup_groups %}
{% if image_near_dup_groups %}
<h2>Image near-duplicates ({{ image_near_dup_groups | length }})</h2>
<p>Two or more images that render as the same picture but do not match byte-for-byte —
   typical causes are a re-encode, resize, colour-space tweak, or metadata rewrite.
   Discards flow through the same per-file trash rail as exact duplicates.</p>

{% for g in image_near_dup_groups %}
<div class="group imgdup-group">
  <h3><span class="badge imgdup">IMAGE NEAR-DUP</span> Group {{ g.id }}</h3>
  <div class="imgdup-meta">
    {% if g.image_near_dup %}
      Hamming distance <strong>{{ g.image_near_dup.max_pairwise_distance }}/{{ g.image_near_dup.hash_bits }}</strong>
      · similarity <strong>{{ (g.similarity_pct or 0) | round(1) }}%</strong>
      · size range <strong>{{ g.image_near_dup.min_size | human_bytes }}</strong>
      – <strong>{{ g.image_near_dup.max_size | human_bytes }}</strong>
      · reclaim <strong>{{ g.reclaim_bytes | human_bytes }}</strong>
    {% else %}
      reclaim <strong>{{ g.reclaim_bytes | human_bytes }}</strong>
    {% endif %}
  </div>
  <table>
    <thead>
      <tr>
        <th style="width:64px;"></th>
        <th>Path</th>
        <th style="width:100px;">Size</th>
        <th style="width:70px;">Score</th>
        <th>Signals</th>
      </tr>
    </thead>
    <tbody>
    {% for m in g.members %}
      <tr class="{% if m.is_proposed_keeper %}keeper{% endif %}">
        <td>
          {% if m.is_proposed_keeper %}
            <span class="badge keep">KEEP</span>
          {% else %}
            <span class="badge discard">TRASH</span>
          {% endif %}
        </td>
        <td class="path {% if not m.is_proposed_keeper %}discard{% endif %}">
          <span class="path-text">{{ m.path }}</span>
        </td>
        <td>{{ m.size | human_bytes }}</td>
        <td class="score">{{ m.score | signed }}</td>
        <td class="signals">
          <ul>
            {% for s in m.signals %}
              <li>{{ s.name }}{% if s.contribution != 0 %}: {{ s.contribution | signed }}{% endif %}</li>
            {% endfor %}
          </ul>
        </td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
</div>
{% endfor %}
{% endif %}

{% set audio_near_dup_groups = report.audio_near_dup_groups %}
{% if audio_near_dup_groups %}
<h2>Audio near-duplicates ({{ audio_near_dup_groups | length }})</h2>
<p>Two or more audio files that fingerprint (via Chromaprint) to the same song
   but do not match byte-for-byte — typical causes are a re-encode at a lower
   bitrate, a container swap (MP3 vs M4A), or a tag rewrite.  Discards flow
   through the same per-file trash rail as exact duplicates.</p>

{% for g in audio_near_dup_groups %}
<div class="group audio-dup-group">
  <h3><span class="badge audio-dup">AUDIO NEAR-DUP</span> Group {{ g.id }}</h3>
  <div class="audio-dup-meta">
    {% if g.audio_near_dup %}
      similarity <strong>{{ (g.similarity_pct or 0) | round(1) }}%</strong>
      · duration range
      <strong>{{ g.audio_near_dup.duration_min_seconds | round(1) }}s</strong>
      – <strong>{{ g.audio_near_dup.duration_max_seconds | round(1) }}s</strong>
      · reclaim <strong>{{ g.reclaim_bytes | human_bytes }}</strong>
    {% else %}
      reclaim <strong>{{ g.reclaim_bytes | human_bytes }}</strong>
    {% endif %}
  </div>
  <table>
    <thead>
      <tr>
        <th style="width:64px;"></th>
        <th>Path</th>
        <th style="width:100px;">Size</th>
        <th style="width:70px;">Score</th>
        <th>Signals</th>
      </tr>
    </thead>
    <tbody>
    {% for m in g.members %}
      <tr class="{% if m.is_proposed_keeper %}keeper{% endif %}">
        <td>
          {% if m.is_proposed_keeper %}
            <span class="badge keep">KEEP</span>
          {% else %}
            <span class="badge discard">TRASH</span>
          {% endif %}
        </td>
        <td class="path {% if not m.is_proposed_keeper %}discard{% endif %}">
          <span class="path-text">{{ m.path }}</span>
        </td>
        <td>{{ m.size | human_bytes }}</td>
        <td class="score">{{ m.score | signed }}</td>
        <td class="signals">
          <ul>
            {% for s in m.signals %}
              <li>{{ s.name }}{% if s.contribution != 0 %}: {{ s.contribution | signed }}{% endif %}</li>
            {% endfor %}
          </ul>
        </td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
</div>
{% endfor %}
{% endif %}

{% set video_near_dup_groups = report.video_near_dup_groups %}
{% if video_near_dup_groups %}
<h2>Video near-duplicates ({{ video_near_dup_groups | length }})</h2>
<p>Two or more videos whose evenly-spaced keyframes render as the same footage
   but that do not match byte-for-byte — typical causes are a re-encode,
   container swap, or resolution downscale.  Discards flow through the same
   per-file trash rail as exact duplicates.</p>

{% for g in video_near_dup_groups %}
<div class="group video-dup-group">
  <h3><span class="badge video-dup">VIDEO NEAR-DUP</span> Group {{ g.id }}</h3>
  <div class="video-dup-meta">
    {% if g.video_near_dup %}
      similarity <strong>{{ (g.similarity_pct or 0) | round(1) }}%</strong>
      · duration range
      <strong>{{ g.video_near_dup.duration_min_seconds | round(1) }}s</strong>
      – <strong>{{ g.video_near_dup.duration_max_seconds | round(1) }}s</strong>
      · reclaim <strong>{{ g.reclaim_bytes | human_bytes }}</strong>
    {% else %}
      reclaim <strong>{{ g.reclaim_bytes | human_bytes }}</strong>
    {% endif %}
  </div>
  <table>
    <thead>
      <tr>
        <th style="width:64px;"></th>
        <th>Path</th>
        <th style="width:100px;">Size</th>
        <th style="width:70px;">Score</th>
        <th>Signals</th>
      </tr>
    </thead>
    <tbody>
    {% for m in g.members %}
      <tr class="{% if m.is_proposed_keeper %}keeper{% endif %}">
        <td>
          {% if m.is_proposed_keeper %}
            <span class="badge keep">KEEP</span>
          {% else %}
            <span class="badge discard">TRASH</span>
          {% endif %}
        </td>
        <td class="path {% if not m.is_proposed_keeper %}discard{% endif %}">
          <span class="path-text">{{ m.path }}</span>
        </td>
        <td>{{ m.size | human_bytes }}</td>
        <td class="score">{{ m.score | signed }}</td>
        <td class="signals">
          <ul>
            {% for s in m.signals %}
              <li>{{ s.name }}{% if s.contribution != 0 %}: {{ s.contribution | signed }}{% endif %}</li>
            {% endfor %}
          </ul>
        </td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
</div>
{% endfor %}
{% endif %}

<h2>Exact duplicates</h2>

{% for g in report.groups if g.kind != 'tree' %}
<div class="group">
  <h3>Group {{ g.id }} — {{ g.hash[:16] }}…</h3>
  <div class="meta">
    {{ g.size | human_bytes }} per file · {{ g.members | length }} members
    · reclaim {{ g.reclaim_bytes | human_bytes }}
  </div>
  <table>
    <thead>
      <tr>
        <th style="width:64px;"></th>
        <th>Path</th>
        <th style="width:70px;">Score</th>
        <th>Signals</th>
      </tr>
    </thead>
    <tbody>
    {% for m in g.members %}
      <tr class="{% if m.is_informational %}info-only{% elif m.is_proposed_keeper %}keeper{% endif %}">
        <td>
          {% if m.is_informational %}
            <span class="badge info">INFO</span>
          {% elif m.is_proposed_keeper %}
            <span class="badge keep">KEEP</span>
          {% else %}
            <span class="badge discard">TRASH</span>
          {% endif %}
          {% if m.reconciled %}<span class="badge recon" title="hash normalised by cross-algo reconciliation">RECON</span>{% endif %}
        </td>
        <td class="path {% if not m.is_proposed_keeper and not m.is_informational %}discard{% endif %}">
          <span class="path-text">{{ m.path }}</span>
        </td>
        <td class="score">{{ m.score | signed }}</td>
        <td class="signals">
          <ul>
            {% for s in m.signals %}
              <li>{{ s.name }}: {{ s.contribution | signed }}</li>
            {% endfor %}
            {% if m.is_informational %}
              <li><em>Hard-linked or APFS clone — informational only, never proposed for deletion.</em></li>
            {% endif %}
          </ul>
        </td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
</div>
{% else %}
<p>No duplicates found. Nothing to do.</p>
{% endfor %}

{% if report.singletons %}
<h2>Unique files ({{ report.singletons | length }})</h2>
<p>These files have no duplicate in this scan. Never proposed for deletion —
   surfaced so you know what's irreplaceable.</p>
<table>
  <thead>
    <tr>
      <th>Path</th>
      <th style="width:100px;">Size</th>
      <th style="width:180px;">Hash</th>
    </tr>
  </thead>
  <tbody>
  {% for s in report.singletons %}
    <tr>
      <td class="path"><span class="path-text">{{ s.path }}</span></td>
      <td>{{ s.size | human_bytes }}</td>
      <td class="path">{{ s.hash[:16] }}…</td>
    </tr>
  {% endfor %}
  </tbody>
</table>
{% endif %}

{% if report.not_yet_hashed_buckets %}
<h2>Cross-source size buckets not yet reconciled ({{ report.not_yet_hashed_buckets | length }})</h2>
<p>These size buckets contain files from multiple sources but reconciliation
   was deferred because it would have exceeded
   <code>--max-cloud-download-mb</code>. Raise the cap and re-scan to fold
   them into duplicate groups.</p>
<table>
  <thead>
    <tr>
      <th style="width:100px;">Size</th>
      <th style="width:140px;">Reason</th>
      <th>Paths</th>
    </tr>
  </thead>
  <tbody>
  {% for b in report.not_yet_hashed_buckets %}
    <tr>
      <td>{{ b.size | human_bytes }}</td>
      <td>{{ b.reason }}</td>
      <td class="path">
        {% for p in b.paths %}<span class="path-text">{{ p }}</span>{% if not loop.last %}<br>{% endif %}{% endfor %}
      </td>
    </tr>
  {% endfor %}
  </tbody>
</table>
{% endif %}

{% if report.archive_skips %}
<h2>Skipped archives ({{ report.archive_skips | length }})</h2>
<p>Archives that could not be walked. Contents are unknown to this scan.</p>
<table>
  <thead>
    <tr>
      <th>Path</th>
      <th style="width:120px;">Reason</th>
      <th>Error</th>
    </tr>
  </thead>
  <tbody>
  {% for s in report.archive_skips %}
    <tr>
      <td class="path"><span class="path-text">{{ s.path }}</span></td>
      <td>{{ s.reason }}</td>
      <td class="path">{{ s.error or "" }}</td>
    </tr>
  {% endfor %}
  </tbody>
</table>
{% endif %}

<footer>
  DuplicateCleaner {{ report.version }} · edit <code>report.json</code>
  to change any proposed keeper, then <code>dc apply report.json --commit</code>.
</footer>

</body>
</html>
